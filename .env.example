# Margin reads this file on start. Copy it to .env and fill in ONE way to reach a model.

# Option A: an OpenAI API key (billed to your API account).
OPENAI_API_KEY=

# Option B: leave the key empty and run `npm run login` once to use your ChatGPT Plus/Pro plan instead.
# The sign-in is saved in .auth/ (git-ignored). `npm run logout` removes it.

# Option C: any server that speaks OpenAI's Chat Completions API, such as a local model. This wins over A and B.
# Ollama: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1   OpenRouter: https://openrouter.ai/api/v1
MARGIN_BASE_URL=
# Its key, if it needs one (OpenRouter does, local servers don't). OPENAI_API_KEY is never sent to these servers.
MARGIN_API_KEY=

# The model to ask. Leave empty to use the first model your ChatGPT plan or server lists (or gpt-5.5 with an API key).
MARGIN_MODEL=

# Let answers search the web when the passage isn't enough (on | off). OpenAI only.
MARGIN_WEB_SEARCH=on

# Where highlights are saved as Markdown, one file per book or page. Margin writes these files: read them, don't edit them.
MARGIN_DIR=~/Documents/Margin
