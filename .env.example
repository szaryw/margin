# Margin reads this file on start. Copy it to .env and fill in ONE way to reach a model.

# Option A: an OpenAI API key (billed to your API account).
OPENAI_API_KEY=

# Option B: leave the key empty and run `npm run login` once to use your ChatGPT Plus/Pro plan instead.
# The sign-in is saved in .auth/ (git-ignored). `npm run logout` removes it.

# The model to ask. Leave empty to use the first model your ChatGPT plan offers (or gpt-5.5 with an API key).
MARGIN_MODEL=

# Let answers search the web when the passage isn't enough (on | off).
MARGIN_WEB_SEARCH=on

# Where highlights are saved as Markdown, one file per book or page. Works well inside an Obsidian vault.
MARGIN_DIR=~/Documents/Margin
